---
import { siteConfig } from '../config/site';

const { faqs, sections } = siteConfig;
---

<section id="faq" class="mx-auto max-w-3xl px-4 py-20 sm:px-6 lg:py-28">
  <div class="reveal text-left">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-primary-ink">{sections.faq.eyebrow}</p>
    <h2 class="mt-3 text-3xl font-semibold text-slate-900 sm:text-4xl">{sections.faq.title}</h2>
    <p class="mt-4 text-lg text-slate-600">{sections.faq.subtitle}</p>
  </div>

  <div class="mt-10 divide-y divide-slate-200/80 border-y border-slate-200/80">
    {faqs.map((f) => (
      <details class="faq group">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-left font-medium text-slate-900 outline-none transition-colors duration-200 hover:text-primary-ink focus-visible:text-primary-ink focus-visible:ring-2 focus-visible:ring-primary/40 focus-visible:rounded-lg [&::-webkit-details-marker]:hidden">
          {f.question}
          <svg viewBox="0 0 24 24" class="size-5 shrink-0 text-slate-500 transition-transform duration-200 ease-snap group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
        </summary>
        <div class="faq-body">
          <div class="overflow-hidden">
            <p class="pb-5 pr-8 leading-relaxed text-slate-600">{f.answer}</p>
          </div>
        </div>
      </details>
    ))}
  </div>
</section>

<style>
  /* Fluid open/close: animate grid row from 0fr to 1fr (no height measurement) */
  .faq-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 250ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .faq[open] .faq-body {
    grid-template-rows: 1fr;
  }
</style>
