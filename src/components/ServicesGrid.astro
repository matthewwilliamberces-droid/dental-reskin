---
import { siteConfig } from '../config/site';

const { services, sections, ui } = siteConfig;
const [featured, ...others] = services;

const tagClass =
  'inline-flex w-fit rounded-md border border-primary/20 bg-primary-light/70 px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.2em] text-primary-ink';
---

<section id="services" class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:py-28">
  <div class="reveal max-w-2xl">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-primary-ink">{sections.services.eyebrow}</p>
    <h2 class="mt-3 text-3xl font-semibold text-slate-900 sm:text-4xl">{sections.services.title}</h2>
    <p class="mt-4 text-lg text-slate-600">{sections.services.subtitle}</p>
  </div>

  <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-4 lg:grid-rows-2">
    {featured && (
      <article class="reveal hairline group relative flex flex-col justify-between overflow-hidden rounded-3xl bg-gradient-to-br from-white via-primary-light/30 to-slate-50 p-8 transition duration-200 ease-snap hover:-translate-y-1 hover:border-primary/40 md:col-span-2 md:p-10 lg:row-span-2">
        <svg viewBox="0 0 200 200" class="pointer-events-none absolute -bottom-10 -right-10 size-72 text-primary/10" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
          <circle cx="100" cy="100" r="90" /><circle cx="100" cy="100" r="62" /><circle cx="100" cy="100" r="34" /><path d="M10 100h180M100 10v180" />
        </svg>
        <div class="relative">
          <div class="flex items-center justify-between">
            <span class="grid size-12 place-items-center rounded-xl bg-primary-ink text-white [&>svg]:size-6" set:html={featured.iconSvg} />
            <span class={tagClass}>{ui.featuredLabel}</span>
          </div>
          <h3 class="mt-8 text-2xl font-semibold text-slate-900 md:text-3xl">{featured.title}</h3>
          <p class="mt-3 max-w-md text-slate-600">{featured.shortDesc}</p>
        </div>
        <dl class="relative mt-10 flex flex-wrap gap-x-10 gap-y-3 border-t border-slate-200/80 pt-5 text-sm">
          {featured.durationHint && (
            <div><dt class="font-mono text-[10px] uppercase tracking-[0.2em] text-slate-500">{ui.durationLabel}</dt><dd class="mt-1 font-medium text-slate-900">{featured.durationHint}</dd></div>
          )}
          {featured.priceFrom && (
            <div class="self-end"><dd class="font-medium text-primary-ink">{featured.priceFrom}</dd></div>
          )}
        </dl>
      </article>
    )}

    {others.map((s) => (
      <article class="reveal hairline group flex flex-col rounded-2xl bg-white p-6 transition duration-200 ease-snap hover:-translate-y-1 hover:border-primary/40 hover:shadow-lg hover:shadow-primary/10">
        <div class="flex items-center justify-between">
          <span class="grid size-10 place-items-center rounded-lg bg-primary-light text-primary-ink [&>svg]:size-5" set:html={s.iconSvg} />
          <span class={tagClass}>{s.tag}</span>
        </div>
        <h3 class="mt-5 text-lg font-semibold text-slate-900">{s.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">{s.shortDesc}</p>
        {s.priceFrom && <p class="mt-auto pt-4 text-sm font-medium text-primary-ink">{s.priceFrom}</p>}
      </article>
    ))}
  </div>
</section>
