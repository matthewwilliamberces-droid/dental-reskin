---
import { siteConfig } from '../config/site';

const { hero, brand, photos } = siteConfig;
---

<section id="top" class="relative overflow-hidden bg-gradient-to-b from-primary-light/50 to-white">
  <div class="mx-auto grid min-h-[calc(100dvh-6.5rem)] max-w-7xl items-center gap-12 px-4 py-12 sm:px-6 lg:grid-cols-[0.95fr_1.05fr] lg:py-16">
    <div>
      <p class="inline-flex animate-fade-in-up items-center gap-2 rounded-full border border-slate-200/60 bg-white/80 px-3 py-1.5 text-xs font-medium text-slate-700 backdrop-blur-md">
        <span class="size-1.5 rounded-full bg-primary-ink" aria-hidden="true"></span>
        {brand.licenseBadge}
      </p>

      <h1 class="delay-1 mt-6 animate-fade-in-up font-display text-4xl font-semibold leading-[1.05] text-slate-900 sm:text-5xl lg:text-6xl">
        {hero.headline}{' '}
        <span class="text-primary-ink">{hero.headlineAccent}</span>
      </h1>

      <p class="delay-2 mt-6 max-w-xl animate-fade-in-up text-lg leading-relaxed text-slate-600">
        {hero.subheadline}
      </p>

      <div class="delay-3 mt-8 flex animate-fade-in-up flex-col gap-3 sm:flex-row">
        <button type="button" data-open-booking class="inline-flex h-12 items-center justify-center rounded-xl bg-primary-ink px-6 font-semibold text-white shadow-lg shadow-primary/20 transition duration-200 ease-snap hover:-translate-y-0.5 hover:bg-surface-dark active:scale-[0.97]">
          {hero.primaryCta}
        </button>
        <a href="#services" class="inline-flex h-12 items-center justify-center rounded-xl border border-slate-200/80 bg-white px-6 font-semibold text-slate-800 ring-1 ring-slate-900/[0.04] transition duration-200 ease-snap hover:border-primary hover:text-primary-ink">
          {hero.secondaryCta}
        </a>
      </div>

      <div class="delay-4 mt-8 flex animate-fade-in-up items-center gap-3">
        <span class="text-lg tracking-widest text-amber-500" aria-hidden="true">★★★★★</span>
        <p class="text-sm font-medium text-slate-600">{hero.ratingText}</p>
      </div>

      <ul class="delay-4 mt-6 animate-fade-in-up space-y-2">
        {hero.checklist.map((item) => (
          <li class="flex items-center gap-2.5 text-sm text-slate-700">
            <span class="size-1.5 shrink-0 rounded-full bg-primary-ink" aria-hidden="true"></span>
            {item}
          </li>
        ))}
      </ul>
    </div>

    <div class="delay-2 relative animate-fade-in-up">
      <div class="overflow-hidden rounded-[2rem] ring-1 ring-slate-900/10 shadow-2xl shadow-slate-900/10">
        <picture>
          <source media="(max-width: 640px)" srcset="/images/photos/hero-mobile.webp" width="700" height="525" />
          <img
            src={photos.hero.src}
            alt={photos.hero.alt}
            width={photos.hero.width}
            height={photos.hero.height}
            fetchpriority="high"
            decoding="async"
            class="aspect-[4/5] size-full object-cover object-[35%_50%] sm:aspect-[4/3] lg:aspect-[5/6]"
          />
        </picture>
      </div>

      <div class="absolute -bottom-5 left-4 flex animate-subtle-float items-center gap-3 rounded-2xl border border-slate-200/60 bg-white/90 px-4 py-3 shadow-xl backdrop-blur-md sm:-left-6">
        <span class="relative flex size-2.5" aria-hidden="true">
          <span class="absolute inline-flex size-full animate-glow-pulse rounded-full bg-emerald-500"></span>
          <span class="relative inline-flex size-2.5 rounded-full bg-emerald-500"></span>
        </span>
        <div>
          <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-slate-600">{hero.availability.label}</p>
          <p class="text-sm font-semibold text-slate-900">{hero.availability.status}</p>
          <p class="text-xs text-slate-600">{hero.availability.detail}</p>
        </div>
      </div>
    </div>
  </div>
</section>
