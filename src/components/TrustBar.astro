---
import { siteConfig } from '../config/site';

const { trustStats } = siteConfig;
---

<section class="border-y border-slate-100 bg-slate-50">
  <dl class="mx-auto grid max-w-7xl grid-cols-2 gap-px bg-slate-200/70 lg:grid-cols-4">
    {trustStats.map((stat) => (
      <div class="bg-slate-50 px-5 py-7 sm:px-8">
        <dt class="text-sm font-medium text-slate-600">{stat.label}</dt>
        <dd class="mt-1 font-display text-2xl font-semibold text-slate-900 sm:text-3xl">{stat.value}</dd>
        <dd class="mt-1 text-xs text-slate-500">{stat.subtext}</dd>
      </div>
    ))}
  </dl>
</section>
