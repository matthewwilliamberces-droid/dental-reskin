---
import { siteConfig } from '../config/site';

const { beforeAfter: ba, ui } = siteConfig;
---

<section id="results" class="bg-slate-50 py-20 lg:py-28">
  <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-[0.8fr_1.2fr]">
    <div class="reveal">
      <h2 class="text-3xl font-semibold text-slate-900 sm:text-4xl">{ba.title}</h2>
      <p class="mt-4 text-lg text-slate-600">{ba.subtitle}</p>
      <p class="mt-6 border-l-2 border-primary pl-4 text-sm text-slate-500">{ba.treatmentNote}</p>
    </div>

    <div class="reveal">
      <div
        id="ba-slider"
        class="hairline relative aspect-[800/520] touch-pan-y select-none overflow-hidden rounded-3xl bg-slate-200"
        style="--pos:50%"
      >
        <img src={ba.beforeImage} alt="" width="800" height="520" loading="lazy" decoding="async" draggable="false" class="absolute inset-0 size-full object-cover" />
        <img src={ba.afterImage} alt="" width="800" height="520" loading="lazy" decoding="async" draggable="false" class="absolute inset-0 size-full object-cover [clip-path:inset(0_0_0_var(--pos))]" />

        <span class="absolute left-4 top-4 rounded-md bg-white/80 px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.2em] text-slate-700 backdrop-blur-md">{ba.beforeLabel}</span>
        <span class="absolute right-4 top-4 rounded-md bg-primary-ink px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.2em] text-white">{ba.afterLabel}</span>

        <div
          id="ba-handle"
          role="slider"
          tabindex="0"
          aria-label={ba.title}
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="50"
          aria-valuetext="50%"
          class="absolute inset-y-0 left-[var(--pos)] z-10 w-11 -translate-x-1/2 cursor-ew-resize outline-none focus-visible:[&>span]:ring-4 focus-visible:[&>span]:ring-accent/60"
        >
          <span class="absolute inset-y-0 left-1/2 w-0.5 -translate-x-1/2 bg-white shadow-[0_0_0_1px_rgb(15_23_42/0.15)]"></span>
          <span class="absolute left-1/2 top-1/2 grid size-11 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-white text-primary-ink shadow-lg ring-1 ring-slate-900/10">
            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 7l-5 5 5 5M15 7l5 5-5 5" /></svg>
          </span>
        </div>
      </div>
      <p class="mt-3 text-center text-xs text-slate-500">{ui.sliderHint}</p>
    </div>
  </div>
</section>

<script>
  const root = document.getElementById('ba-slider') as HTMLElement | null;
  const handle = document.getElementById('ba-handle') as HTMLElement | null;

  if (root && handle) {
    const state = { v: 50 };
    let current: { pause: () => unknown } | null = null;
    let lib: Promise<typeof import('animejs')> | null = null;
    const load = () => (lib ??= import('animejs'));

    const render = (v: number) => {
      const p = Math.min(100, Math.max(0, v));
      state.v = p;
      root.style.setProperty('--pos', `${p}%`);
      handle.setAttribute('aria-valuenow', String(Math.round(p)));
      handle.setAttribute('aria-valuetext', `${Math.round(p)}%`);
    };

    const toward = async (target: number) => {
      current?.pause();
      try {
        const { animate, spring } = await load();
        current = animate(state, {
          v: target,
          ease: spring({ stiffness: 240, damping: 26, mass: 1 }),
          onUpdate: () => render(state.v),
        });
      } catch {
        render(target);
      }
    };

    const fromPointer = (e: PointerEvent) => {
      const r = root.getBoundingClientRect();
      render(((e.clientX - r.left) / r.width) * 100);
    };

    let dragging = false;
    root.addEventListener('pointerdown', (e) => {
      current?.pause();
      dragging = true;
      root.setPointerCapture(e.pointerId);
      fromPointer(e);
      handle.focus({ preventScroll: true });
    });
    root.addEventListener('pointermove', (e) => dragging && fromPointer(e));
    const stop = () => (dragging = false);
    root.addEventListener('pointerup', stop);
    root.addEventListener('pointercancel', stop);

    handle.addEventListener('keydown', (e) => {
      const steps: Record<string, number> = { ArrowLeft: -5, ArrowDown: -5, ArrowRight: 5, ArrowUp: 5 };
      let target: number | null = null;
      if (e.key in steps) target = state.v + steps[e.key];
      else if (e.key === 'Home') target = 0;
      else if (e.key === 'End') target = 100;
      if (target !== null) {
        e.preventDefault();
        toward(Math.min(100, Math.max(0, target)));
      }
    });

    // On first view, preload the library and play a short sweep to hint at dragging.
    const io = new IntersectionObserver(
      async ([entry]) => {
        if (!entry.isIntersecting) return;
        io.disconnect();
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        try {
          const { animate, createTimeline } = await load();
          void animate; // tree-shaken named import kept for clarity
          current = createTimeline()
            .add(state, { v: 30, duration: 450, ease: 'outExpo', onUpdate: () => render(state.v) })
            .add(state, { v: 55, duration: 500, ease: 'inOutExpo', onUpdate: () => render(state.v) });
        } catch {
          /* decorative only */
        }
      },
      { threshold: 0.6 },
    );
    io.observe(root);
  }
</script>
