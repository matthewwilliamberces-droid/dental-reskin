---
import { siteConfig } from '../config/site';

const { testimonials, sections, ui } = siteConfig;
---

<section id="reviews" class="bg-surface-dark py-20 text-white lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="reveal max-w-2xl">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">{sections.reviews.eyebrow}</p>
      <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">{sections.reviews.title}</h2>
      <p class="mt-4 text-lg text-white/70">{sections.reviews.subtitle}</p>
    </div>

    <div class="mt-12 grid gap-4 md:grid-cols-2">
      {testimonials.map((t) => (
        <figure class="reveal flex flex-col rounded-2xl border border-white/10 bg-white/[0.04] p-6 ring-1 ring-white/[0.03] transition duration-200 ease-snap hover:border-accent/40 md:p-8">
          <div class="flex items-center justify-between gap-3">
            <div class="tracking-widest text-amber-400" role="img" aria-label={`${t.rating} / 5`}>
              <span aria-hidden="true">{'★'.repeat(t.rating)}</span>
            </div>
            <span class="rounded-md border border-white/15 px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.2em] text-white/70">{t.treatment}</span>
          </div>
          <blockquote class="mt-5 flex-1 text-base leading-relaxed text-white/90">{t.quote}</blockquote>
          <figcaption class="mt-6 flex items-center justify-between border-t border-white/10 pt-4 text-sm">
            <span><span class="font-semibold">{t.author}</span> <span class="text-white/60">· {t.suburb}</span></span>
            {t.verified && (
              <span class="inline-flex items-center gap-1.5 text-accent">
                <span aria-hidden="true">&#10003;</span>
                {ui.verified}
              </span>
            )}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
