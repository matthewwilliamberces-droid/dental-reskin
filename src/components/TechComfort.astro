---
import { siteConfig } from '../config/site';

const { benefits, sections, photos } = siteConfig;
---

<section id="about" class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:py-28">
  <div class="grid items-start gap-12 lg:grid-cols-[1fr_1fr]">
    <div class="reveal lg:sticky lg:top-28">
      <div class="relative">
        <img
          src={photos.clinic.src}
          alt={photos.clinic.alt}
          width={photos.clinic.width}
          height={photos.clinic.height}
          loading="lazy"
          decoding="async"
          class="aspect-[4/3] w-full rounded-3xl object-cover ring-1 ring-slate-900/10"
        />
        <img
          src={photos.scan.src}
          alt={photos.scan.alt}
          width={photos.scan.width}
          height={photos.scan.height}
          loading="lazy"
          decoding="async"
          class="absolute -bottom-8 right-4 w-2/5 rounded-2xl border-4 border-white object-cover shadow-xl sm:-right-4"
        />
      </div>
    </div>

    <div class="lg:pt-4">
      <div class="reveal">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-primary-ink">{sections.comfort.eyebrow}</p>
        <h2 class="mt-3 text-3xl font-semibold text-slate-900 sm:text-4xl">{sections.comfort.title}</h2>
        <p class="mt-4 text-lg text-slate-600">{sections.comfort.subtitle}</p>
      </div>

      <ol class="mt-8 divide-y divide-slate-200/80 border-y border-slate-200/80">
        {benefits.map((b, i) => (
          <li class="reveal flex gap-5 py-6">
            <span class="font-display text-2xl font-semibold text-primary-ink" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="text-lg font-semibold text-slate-900">{b.title}</h3>
              <p class="mt-1.5 text-slate-600">{b.desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
