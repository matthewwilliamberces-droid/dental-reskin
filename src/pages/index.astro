---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import BeforeAfterSlider from '../components/BeforeAfterSlider.astro';
import TechComfort from '../components/TechComfort.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import BookingModal from '../components/BookingModal.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Navbar />
  <main>
    <Hero />
    <TrustBar />
    <ServicesGrid />
    <BeforeAfterSlider />
    <TechComfort />
    <Testimonials />
    <Faq />
  </main>
  <Footer />
