---
import { siteConfig } from '../config/site';

const { services, sections, ui } = siteConfig;
const [featured, ...others] = services;

const tagClass =
  'inline-flex w-fit rounded-md border border-primary/20 bg-primary-light/80 px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.2em] text-primary-ink';
---

<section id="services" class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:py-28">
  <div class="reveal max-w-2xl">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-primary-ink">{sections.services.eyebrow}</p>
    <h2 class="mt-3 text-3xl font-semibold text-slate-900 sm:text-4xl">{sections.services.title}</h2>
    <p class="mt-4 text-lg text-slate-600">{sections.services.subtitle}</p>
  </div>

  <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-4 lg:grid-rows-2">
    {featured && (
      <article class="reveal group relative isolate flex min-h-[28rem] flex-col justify-end overflow-hidden rounded-3xl bg-slate-900 text-white ring-1 ring-slate-900/10 md:col-span-2 lg:row-span-2">
        <img
          src={featured.image.src}
          alt={featured.image.alt}
          width={featured.image.width}
          height={featured.image.height}
          loading="lazy"
          decoding="async"
          class="absolute inset-0 -z-10 size-full object-cover transition-transform duration-500 ease-snap group-hover:scale-105"
        />
        <div class="absolute inset-0 -z-10 bg-gradient-to-t from-slate-950/90 via-slate-950/40 to-transparent"></div>
        <div class="p-8 md:p-10">
          <span class="inline-flex w-fit rounded-md border border-white/30 bg-white/10 px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.2em] backdrop-blur-md">{ui.featuredLabel}</span>
          <h3 class="mt-4 text-2xl font-semibold md:text-3xl">{featured.title}</h3>
          <p class="mt-3 max-w-md text-white/85">{featured.shortDesc}</p>
          <dl class="mt-6 flex flex-wrap gap-x-10 gap-y-3 border-t border-white/20 pt-5 text-sm">
            {featured.durationHint && (
              <div><dt class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/70">{ui.durationLabel}</dt><dd class="mt-1 font-medium">{featured.durationHint}</dd></div>
            )}
            {featured.priceFrom && <div class="self-end"><dd class="font-medium text-accent">{featured.priceFrom}</dd></div>}
          </dl>
        </div>
      </article>
    )}

    {others.map((s) => (
      <article class="reveal group flex flex-col overflow-hidden rounded-2xl border border-slate-200/80 bg-white ring-1 ring-slate-900/[0.04] transition duration-200 ease-snap hover:-translate-y-1 hover:border-primary/40 hover:shadow-lg hover:shadow-primary/10">
        <div class="relative h-40 overflow-hidden bg-slate-100">
          <img
            src={s.image.src}
            alt={s.image.alt}
            width={s.image.width}
            height={s.image.height}
            loading="lazy"
            decoding="async"
            class="size-full object-cover transition-transform duration-500 ease-snap group-hover:scale-105"
          />
          <span class={`${tagClass} absolute left-3 top-3 backdrop-blur-md`}>{s.tag}</span>
        </div>
        <div class="flex flex-1 flex-col p-5">
          <h3 class="text-lg font-semibold text-slate-900">{s.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">{s.shortDesc}</p>
          {s.priceFrom && <p class="mt-auto pt-4 text-sm font-medium text-primary-ink">{s.priceFrom}</p>}
        </div>
      </article>
    ))}
  </div>
</section>
