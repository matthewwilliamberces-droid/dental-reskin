---
import { siteConfig } from '../config/site';

const { benefits, sections } = siteConfig;
---

<section id="about" class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:py-28">
  <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr]">
    <div class="reveal lg:sticky lg:top-28 lg:self-start">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-primary-ink">{sections.comfort.eyebrow}</p>
      <h2 class="mt-3 text-3xl font-semibold text-slate-900 sm:text-4xl">{sections.comfort.title}</h2>
      <p class="mt-4 text-lg text-slate-600">{sections.comfort.subtitle}</p>
    </div>

    <ol class="divide-y divide-slate-200/80 border-y border-slate-200/80">
      {benefits.map((b, i) => (
        <li class="reveal flex gap-5 py-7">
          <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-primary-light text-primary-ink ring-1 ring-primary/15 [&>svg]:size-5" set:html={b.iconSvg} />
          <div>
            <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-slate-600">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="mt-1 text-lg font-semibold text-slate-900">{b.title}</h3>
            <p class="mt-2 text-slate-600">{b.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
